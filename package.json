{
  "name": "simerp-qa-ai-flow",
  "version": "1.0.0",
  "private": true,
  "description": "AI-driven QA automation flow for SIM ERP using VS Code agents & skills",
  "scripts": {
    "test": "playwright test --config=tests/playwright.config.ts --project=chromium; code=$?; npm run report:html; exit $code",
    "test:headed": "playwright test --config=tests/playwright.config.ts --project=chromium --headed; code=$?; npm run report:html; exit $code",
    "test:cross-browser": "playwright test --config=tests/playwright.config.ts; code=$?; npm run report:html; exit $code",
    "test:report": "playwright show-report reports/results/html",
    "test:ci": "playwright test --config=ci-cd-pipeline/playwright.config.ts --project=chromium",
    "test:ci:report": "playwright show-report reports/results/ci-pipeline-html",
    "pipeline": "ts-node scripts/pipeline.ts",
    "ui": "node ui/launch.js start",
    "ui:stop": "node ui/launch.js stop",
    "ui:status": "node ui/launch.js status",
    "ui:restart": "node ui/launch.js restart",
    "ui:dev": "ts-node ui/server.ts",
    "pipeline:headless": "ts-node scripts/pipeline-headless.ts",
    "report:excel": "ts-node .claude/skills/excel-reporter/scripts/generate-excel.ts",
    "report:html": "ts-node .claude/skills/pipeline-report/scripts/generate-html-report.ts",
    "report:qa": "ts-node .claude/skills/pipeline-report/scripts/generate-qa-report.ts",
    "report:md": "ts-node scripts/generate-test-case-md.ts",
    "cases:stale": "ts-node --transpile-only scripts/cases-lifecycle.ts stale",
    "cases:check": "ts-node --transpile-only scripts/cases-lifecycle.ts check",
    "cases:snapshot": "ts-node --transpile-only scripts/cases-lifecycle.ts snapshot",
    "cases:next-id": "ts-node --transpile-only scripts/cases-lifecycle.ts next-id",
    "cases:mark": "ts-node --transpile-only scripts/cases-lifecycle.ts mark",
    "cases:retire": "ts-node --transpile-only scripts/cases-lifecycle.ts retire",
    "cases:reactivate": "ts-node --transpile-only scripts/cases-lifecycle.ts reactivate",
    "cases:from-results": "ts-node --transpile-only scripts/cases-lifecycle.ts from-results",
    "cases:registry-sync": "ts-node --transpile-only scripts/cases-lifecycle.ts registry-sync",
    "cases:selftest": "ts-node --transpile-only scripts/cases-lifecycle.selftest.ts",
    "kb:update": "ts-node scripts/update-knowledge-base.ts",
    "lint:tests": "ts-node scripts/lint-test-conventions.ts",
    "lint:tests:baseline": "ts-node scripts/lint-test-conventions.ts --update-baseline",
    "extract:selectors": "ts-node scripts/extract-selector-inventory.ts",
    "ledger:locator-failures": "ts-node scripts/build-locator-failure-ledger.ts",
    "capture:dom-snapshot": "ts-node scripts/capture-dom-snapshot.ts",
    "report:coverage": "ts-node scripts/coverage-report.ts",
    "review:cases": "ts-node scripts/test-case-review.ts",
    "zoho:reauth": "ts-node scripts/zoho-reauth.ts",
    "ops": "node ops-dashboard/launch.js start",
    "ops:stop": "node ops-dashboard/launch.js stop",
    "ops:status": "node ops-dashboard/launch.js status",
    "ops:restart": "node ops-dashboard/launch.js restart",
    "ops:dev": "ts-node --transpile-only ops-dashboard/server.ts",
    "ops:sync": "ts-node scripts/ops/sync-zoho.ts",
    "ops:cron:install": "ts-node scripts/ops/ops-cron.ts install",
    "ops:cron:uninstall": "ts-node scripts/ops/ops-cron.ts uninstall",
    "ops:cron:status": "ts-node scripts/ops/ops-cron.ts status",
    "ops:check-deps": "node scripts/ops/check-deps.js",
    "ops:health": "ts-node scripts/ops/health-check.ts",
    "ops:watch": "ts-node scripts/ops/deploy-watch.ts"
  },
  "devDependencies": {
    "@clack/prompts": "^1.5.1",
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "axios": "^1.7.0",
    "caveman": "^0.1.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.0",
    "zod": "^3.25.76"
  }
}
