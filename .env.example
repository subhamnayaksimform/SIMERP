# SIM ERP staging environment
BASE_URL=https://staging.simerp.example.com

# Anthropic API key — required for automated full-pipeline (npm run pipeline → option 0)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Zoho Projects API (OAuth2)
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here
ZOHO_PORTAL_ID=your_portal_id_here
ZOHO_PROJECT_ID=your_project_id_here
ZOHO_REGION=com

# Test credentials for SIM ERP (do NOT commit real values)
# Account 1 — Primary / Admin (direct credentials) → Playwright fixture: primaryPage → storageState.json
SIMERP_USERNAME=primary.admin@example.com
SIMERP_PASSWORD=changeme

# Account 2 — Test user (TM / Employee, direct credentials) → Playwright fixture: testUserPage → storageState-punit.json
SIMERP_TEST_USERNAME=test.user@example.com
SIMERP_TEST_PASSWORD=changeme

# Account 3 — Project Manager persona (direct credentials) → Playwright fixture: pmPage → storageState-pm.json
SIMERP_PM_USERNAME=pm.user@example.com
SIMERP_PM_PASSWORD=changeme

# Account 4 — PMO persona (direct credentials) → Playwright fixture: pmoPage → storageState-pmo.json
SIMERP_PMO_USERNAME=pmo.user@example.com
SIMERP_PMO_PASSWORD=changeme

# Account 5 — Team Manager / department approver persona (direct credentials) → Playwright fixture: tmPage → storageState-tm.json
SIMERP_TM_USERNAME=tm.user@example.com
SIMERP_TM_PASSWORD=changeme

# Account 6 — Employee (base worker) persona (direct credentials) → Playwright fixture: empPage → storageState-emp.json
SIMERP_EMP_USERNAME=employee.user@example.com
SIMERP_EMP_PASSWORD=changeme

# Account 7 — EM (Engineering/Employee Manager) persona (direct credentials) → Playwright fixture: emPage → storageState-em.json
SIMERP_EM_USERNAME=em.user@example.com
SIMERP_EM_PASSWORD=changeme

# Account 8 — CSM persona (direct credentials) → Playwright fixture: csmPage → storageState-csm.json
SIMERP_CSM_USERNAME=csm.user@example.com
SIMERP_CSM_PASSWORD=changeme

# ── QA Ops Dashboard (npm run ops) — no Claude needed ──
# Uses the ZOHO_* values above; "me" is whoever owns ZOHO_REFRESH_TOKEN.
# OPS_PORT=4400
# OPS_SYNC_CRON=0 */2 * * *
# OPS_WATCH_CRON=*/10 * * * *        # deploy watcher (starts a health run after each deploy)
# API_HEALTH_SLOW_MS=5000             # API checks fail when a call takes longer than this
# Extra environments to watch (probed for uptime/version/response time; suites run on dev only):
# OPS_STAGING_URL=  OPS_STAGING_API_URL=
# OPS_LOCAL_URL=http://localhost:5174  OPS_LOCAL_API_URL=http://localhost:3002
