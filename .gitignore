# knowledge-base/ persists, but these subtrees carry PII (real employee names,
# live-ERP screenshots) and must never be committed
reports/knowledge-base/dom-snapshots/

# Machine-local Claude Code settings (absolute paths, local grants) — never share
.claude/settings.local.json

