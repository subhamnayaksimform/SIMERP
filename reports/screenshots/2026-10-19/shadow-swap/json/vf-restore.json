  "project": {
    "publicId": "fd79a71e-c3c3-4c75-8a06-38509a14c7a3",
    "name": "ViewForge | BI Dashboard",
    "alias": null,
    "accountGrade": 9,
    "description": "ViewForge | BI Dashboard is a HIPAA compliant, AI assisted revenue and follow up operating system for orthodontists and general dentists performing high-ticket treatments. This Statement of Work covers the MVP Phase 1 build and the subsequent growth phases.\n\nObjectives: negotiate treatment pricing and payment plans deterministically through AI assisted conversations; improve case acceptance rates by 10-15% through realtime treatment coordinator coaching; collect down payments and recurring payments securely; track and recover deferred cases through structured observation workflows; maintain full auditability and financial governance while keeping decision authority with the practice.\n\nKey deliverables: three layer financial firewall architecture (conversational layer, deterministic constraint engine, ledger layer); patient negotiation portal with AI assisted coaching; treatment coordinator chairside tablet application; payment processing integration with PHI shield architecture; observation recall and follow-up system; HIPAA compliant infrastructure and audit logging; web based staff dashboards for operations and financial visibility.",
    "isBillable": true,
    "customerSuccessManager": {
      "publicId": "4174b8c1-9d89-4b61-bfd7-075924620091",
